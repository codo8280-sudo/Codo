# Public CODO API used by the Flutter client.
CODO_API_BASE_URL=

# Mobile OpenID Connect client. These values are public application configuration,
# not client secrets. Native mobile clients must use Authorization Code + PKCE.
CODO_OIDC_ISSUER=
CODO_OIDC_CLIENT_ID=codo-mobile
CODO_OIDC_REDIRECT_URL=ci.codo.app:/oauthredirect
CODO_OIDC_POST_LOGOUT_REDIRECT_URL=ci.codo.app:/oauthredirect
CODO_OIDC_SCOPES=openid,profile,email,offline_access
# Development only for an HTTP identity provider. Must be false in staging/production.
CODO_OIDC_ALLOW_INSECURE_HTTP=false

# Stitch tooling only. Never compile this value into the application.
STITCH_API_KEY=
