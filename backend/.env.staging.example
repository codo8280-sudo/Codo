# CODO staging runtime example - no secrets
CODO_DATABASE_PROVIDER=supabase
CODO_DATABASE_URL=postgresql://postgres.evchtqxpthfaekpaeibh:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require
CODO_PUBLIC_MAX_RESULTS=20

# Temporary recovery only. Remove after the first OIDC SUPER_ADMIN is granted.
CODO_ADMIN_BOOTSTRAP_TOKEN=

# Fill only after the staging OIDC server and public client are enabled.
CODO_OIDC_ISSUER=
CODO_OIDC_AUDIENCE=
CODO_OIDC_ALGORITHMS=RS256
CODO_OIDC_CACHE_SECONDS=300
CODO_OIDC_CLOCK_SKEW_SECONDS=30
CODO_OIDC_HTTP_TIMEOUT_SECONDS=5
CODO_OIDC_ALLOW_INSECURE_HTTP=false

# Optional AI providers - server-side only.
CODO_EMBEDDING_URL=
CODO_EMBEDDING_API_KEY=
CODO_EMBEDDING_MODEL=
CODO_LLM_URL=
CODO_LLM_API_KEY=
CODO_LLM_MODEL=
