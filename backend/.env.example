# PostgreSQL corpus database. Required for corpus/search/user-data routes.
CODO_DATABASE_URL=postgresql://user:password@localhost:5432/codo
# postgres or supabase. Supabase runs an additional provider security preflight.
CODO_DATABASE_PROVIDER=postgres

# Optional integration-test database. Always use a disposable database/schema.
CODO_TEST_DATABASE_URL=

# Durable legal originals/snapshots. In containers use /app/storage.
CODO_STORAGE_DIR=storage
CODO_ACQUISITION_MAX_BYTES=52428800
CODO_PUBLIC_MAX_RESULTS=20

# Shared OIDC trust configuration for citizens and administrators.
# The API validates signature, issuer, audience, exp and iat against JWKS.
CODO_OIDC_ISSUER=
CODO_OIDC_AUDIENCE=codo-api
CODO_OIDC_ALGORITHMS=RS256
CODO_OIDC_CACHE_SECONDS=300
CODO_OIDC_CLOCK_SKEW_SECONDS=30
CODO_OIDC_HTTP_TIMEOUT_SECONDS=5
# Development only. Keep false in shared staging and production.
CODO_OIDC_ALLOW_INSECURE_HTTP=false

# Emergency/bootstrap recovery only. Remove once an OIDC SUPER_ADMIN exists.
CODO_ADMIN_BOOTSTRAP_TOKEN=

# Optional OpenAI-compatible embeddings endpoint.
# When absent, CODO safely falls back to lexical PostgreSQL search.
CODO_EMBEDDING_URL=
CODO_EMBEDDING_API_KEY=
CODO_EMBEDDING_MODEL=

# Optional OpenAI-compatible chat-completions endpoint.
# When absent, CODO IA returns an explicit insufficient-source/configuration state.
CODO_LLM_URL=
CODO_LLM_API_KEY=
CODO_LLM_MODEL=
